# .env.example — 실제 값을 채워 .env 파일로 저장하세요 (이 파일은 커밋해도 됩니다)

# 한국투자증권 Open API (모의투자)
KIS_APP_KEY=여기에_모의투자_앱키
KIS_APP_SECRET=여기에_모의투자_앱시크릿
KIS_CANO=계좌번호앞8자리
KIS_ACNT_PRDT_CD=01
KIS_USE_MOCK=true

# 실전투자 전환 시 아래 값 채우고 KIS_USE_MOCK=false 로 변경
KIS_REAL_APP_KEY=여기에_실전투자_앱키
KIS_REAL_APP_SECRET=여기에_실전투자_앱시크릿
KIS_REAL_CANO=실전계좌번호앞8자리

# Telegram 봇
TELEGRAM_TOKEN=봇토큰
TELEGRAM_CHAT_ID=채팅ID
TELEGRAM_ALLOWED_ID=허가된_사용자_ChatID
